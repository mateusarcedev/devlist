# =============================================================
# Tools4.tech — docker-compose environment contract
# Copy this file to .env and replace every required placeholder.
# =============================================================

# PostgreSQL
POSTGRES_USER=devlist
POSTGRES_PASSWORD=change_me
POSTGRES_DB=devlist

# Prisma
# "postgres" is the docker-compose service name.
DATABASE_URL=postgresql://devlist:change_me@postgres:5432/devlist?schema=public
DIRECT_URL=postgresql://devlist:change_me@postgres:5432/devlist?schema=public

# Authentication
# Required in API and web. Use the exact same value in both.
# Generate a strong value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# GitHub OAuth App
# Production callback must match API_URL exactly:
# https://api.yourdomain.com/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional GitHub token used only for public contributor/repository stats.
GITHUB_TOKEN=

# Public production URLs. The supported production auth topology uses
# sibling hosts under one parent domain.
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Parent domain used only by the HTTP-only access cookie so the frontend SSR
# can read the session. The refresh cookie remains host-only on the API.
# Use a bare domain without scheme/path/port.
COOKIE_DOMAIN=yourdomain.com

# Browser-visible API URL, embedded in the Next.js bundle at build time.
NEXT_PUBLIC_URL_API=https://api.yourdomain.com

# Server-side API URL used by the web container over the Docker network.
URL_API=http://api:3001
