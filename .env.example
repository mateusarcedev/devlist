# =============================================================
# Devlist — production self-host environment
# Copy this file to .env on the VPS and replace placeholders.
# Never commit the real .env.
# =============================================================

# Immutable application images.
IMAGE_REGISTRY=ghcr.io/mateusarcedev
# Required: full 40-char git commit SHA of a successful "Publish production
# images" run. "latest" is rejected by ops/deploy.sh to keep rollback
# deterministic.
IMAGE_TAG=

# PostgreSQL
POSTGRES_USER=devlist
POSTGRES_PASSWORD=
POSTGRES_DB=devlist

# Prisma
# "postgres" is the private Docker service name.
# Use a URL-safe password (e.g. `openssl rand -hex 24`); it is embedded in the
# URLs below, so characters such as @ : / # ? break them. Replace change_me in all three places.
DATABASE_URL=postgresql://devlist:change_me@postgres:5432/devlist?schema=public
DIRECT_URL=postgresql://devlist:change_me@postgres:5432/devlist?schema=public

# Authentication
# Required in API and web. Use the exact same value in both.
# Generate a strong value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# GitHub OAuth App
# Production callback:
# https://api.devlist.mateusarce.dev/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional GitHub token used only for public contributor/repository stats.
GITHUB_TOKEN=

# Public URLs
API_URL=https://api.devlist.mateusarce.dev
FRONTEND_URL=https://devlist.mateusarce.dev

# Domain of the HTTP-only access cookie. Scoped to the Devlist host so it is
# sent to devlist.mateusarce.dev and api.devlist.mateusarce.dev only, not to
# other *.mateusarce.dev apps. The refresh cookie remains host-only on the API.
COOKIE_DOMAIN=devlist.mateusarce.dev

# Web server-side API URL inside Docker.
URL_API=http://api:3001

# Build-time only: NOT read from this file at runtime. The browser API URL is
# compiled into the web image by publish-images.yml from the GitHub repository
# variable PRODUCTION_API_URL (default below). Changing it here has no effect
# without republishing the web image.
NEXT_PUBLIC_URL_API=https://api.devlist.mateusarce.dev

# Caddy / automatic TLS
WEB_DOMAIN=devlist.mateusarce.dev
API_DOMAIN=api.devlist.mateusarce.dev
# Real address; ops/deploy.sh rejects example.com placeholders.
ACME_EMAIL=

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
