# Devlist web — local development environment
# Copy to apps/web/.env.local.

# Server-side API URL.
URL_API=http://localhost:3001

# Browser-visible API URL.
NEXT_PUBLIC_URL_API=http://localhost:3001

# Must exactly match the API JWT_SECRET.
JWT_SECRET=replace-with-a-local-secret

# Optional; used only for public contributor/repository stats.
GITHUB_TOKEN=
